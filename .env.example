# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Live (voice + video) model. Check https://ai.google.dev/gemini-api/docs/models if this name changes.
LIVE_MODEL=gemini-3.8-live
# Text model used to read the CV skills and write the final report
TEXT_MODEL=gemini-3.8-flash

VOICE=Kore
INTERVIEW_MINUTES=10
PORT=3000

# false = key from Google AI Studio (starts with "AIza")
# true  = Google Cloud / Vertex AI express-mode key (starts with "AQ.")
USE_VERTEX=false
